{
  "type": {
    "$description": "Tailwind 정본 이름을 그대로 쓴다. 신규 어휘 0개 — 우리 일은 기본값 튜닝이다",
    "size": {
      "xs":   { "$type": "dimension", "$value": "0.75rem",  "$extensions": { "design.massive.px": 12, "design.massive.typeTier": "body" } },
      "sm":   { "$type": "dimension", "$value": "0.875rem", "$extensions": { "design.massive.px": 14, "design.massive.typeTier": "body" }, "$description": "shadcn 기본 본문 — 버튼·인풋·테이블. 화면 면적의 대부분" },
      "base": { "$type": "dimension", "$value": "1rem",     "$extensions": { "design.massive.px": 16, "design.massive.typeTier": "body" } },
      "lg":   { "$type": "dimension", "$value": "1.125rem", "$extensions": { "design.massive.px": 18, "design.massive.typeTier": "body" } },
      "xl":   { "$type": "dimension", "$value": "1.25rem",  "$extensions": { "design.massive.px": 20, "design.massive.typeTier": "mid" } },
      "2xl":  { "$type": "dimension", "$value": "1.5rem",   "$extensions": { "design.massive.px": 24, "design.massive.typeTier": "mid" } },
      "3xl":  { "$type": "dimension", "$value": "1.875rem", "$extensions": { "design.massive.px": 30, "design.massive.typeTier": "heading" } },
      "4xl":  { "$type": "dimension", "$value": "2.25rem",  "$extensions": { "design.massive.px": 36, "design.massive.typeTier": "heading" } },
      "5xl":  { "$type": "dimension", "$value": "3rem",     "$extensions": { "design.massive.px": 48, "design.massive.typeTier": "heading" } }
    },
    "lineHeight": {
      "$description": "무단위 비율 3단. 코드는 이 비율을 그대로 쓰고, Figma는 빌드가 사이즈에 곱한 px를 쓴다 — PERCENT가 변수 바인딩과 양립하지 않아 #10에서 뒤집힌 결정",
      "body":    { "$type": "number", "$value": 1.6,  "$description": "xs·sm·base·lg. 한국어는 라틴보다 글자 밀도가 높고 받침으로 세로 공간을 더 쓴다" },
      "mid":     { "$type": "number", "$value": 1.4,  "$description": "xl·2xl" },
      "heading": { "$type": "number", "$value": 1.25, "$description": "3xl·4xl·5xl" }
    },
    "tracking": {
      "$description": "본문은 0. 큰 글자만 조인다 — 본문 tracking을 음수로 주면 한글이 뭉친다",
      "body":    { "$type": "dimension", "$value": "0em" },
      "mid":     { "$type": "dimension", "$value": "-0.01em" },
      "heading": { "$type": "dimension", "$value": "-0.02em" }
    },
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, \"Apple SD Gothic Neo\", \"Noto Sans KR\", \"Malgun Gothic\", sans-serif",
        "$extensions": { "design.massive.figmaFamily": "Pretendard" },
        "$description": "Figma에는 STRING 변수로 패밀리 이름만 나간다(로컬 폰트를 못 보는 실행 컨텍스트 우회 — #9)"
      }
    }
  },

  "space": {
    "$description": "코드는 --spacing 배수 하나로 동적 생성한다. 아래 13개는 Figma 간격 피커용 프리셋이지 파리티가 아니다 — 코드는 이 목록 밖 배수도 쓴다(shadcn이 gap-1.5를 쓴다)",
    "base": { "$type": "dimension", "$value": "0.25rem", "$extensions": { "design.massive.px": 4, "design.massive.cssOnly": true }, "$description": "--spacing. Tailwind 기본과 동일 = 실질 무변경" },
    "0":  { "$type": "dimension", "$value": "0px",  "$extensions": { "design.massive.px": 0,  "design.massive.figmaOnly": true } },
    "1":  { "$type": "dimension", "$value": "4px",  "$extensions": { "design.massive.px": 4,  "design.massive.figmaOnly": true } },
    "2":  { "$type": "dimension", "$value": "8px",  "$extensions": { "design.massive.px": 8,  "design.massive.figmaOnly": true } },
    "3":  { "$type": "dimension", "$value": "12px", "$extensions": { "design.massive.px": 12, "design.massive.figmaOnly": true } },
    "4":  { "$type": "dimension", "$value": "16px", "$extensions": { "design.massive.px": 16, "design.massive.figmaOnly": true } },
    "5":  { "$type": "dimension", "$value": "20px", "$extensions": { "design.massive.px": 20, "design.massive.figmaOnly": true } },
    "6":  { "$type": "dimension", "$value": "24px", "$extensions": { "design.massive.px": 24, "design.massive.figmaOnly": true } },
    "8":  { "$type": "dimension", "$value": "32px", "$extensions": { "design.massive.px": 32, "design.massive.figmaOnly": true } },
    "10": { "$type": "dimension", "$value": "40px", "$extensions": { "design.massive.px": 40, "design.massive.figmaOnly": true } },
    "12": { "$type": "dimension", "$value": "48px", "$extensions": { "design.massive.px": 48, "design.massive.figmaOnly": true } },
    "16": { "$type": "dimension", "$value": "64px", "$extensions": { "design.massive.px": 64, "design.massive.figmaOnly": true } },
    "20": { "$type": "dimension", "$value": "80px", "$extensions": { "design.massive.px": 80, "design.massive.figmaOnly": true } },
    "24": { "$type": "dimension", "$value": "96px", "$extensions": { "design.massive.px": 96, "design.massive.figmaOnly": true } }
  },

  "radius": {
    "$description": "shadcn CLI의 곱셈 7단. calc로 남기지 않고 빌드 시점에 선계산한다 — Figma Variable이 숫자만 받으므로 계산은 어차피 확정돼야 하고, 그 지점을 빌드로 당기면 코드와 Figma가 같은 값을 본다",
    "base": { "$type": "dimension", "$value": "0.625rem", "$extensions": { "design.massive.px": 10 }, "$description": "--radius. shadcn 컴포넌트가 직접 참조하므로 그대로 출력한다" },
    "sm":  { "$type": "dimension", "$value": "0.375rem", "$extensions": { "design.massive.px": 6,  "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 0.6 } } },
    "md":  { "$type": "dimension", "$value": "0.5rem",   "$extensions": { "design.massive.px": 8,  "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 0.8 } } },
    "lg":  { "$type": "dimension", "$value": "0.625rem", "$extensions": { "design.massive.px": 10, "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 1.0 } } },
    "xl":  { "$type": "dimension", "$value": "0.875rem", "$extensions": { "design.massive.px": 14, "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 1.4 } } },
    "2xl": { "$type": "dimension", "$value": "1.125rem", "$extensions": { "design.massive.px": 18, "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 1.8 } } },
    "3xl": { "$type": "dimension", "$value": "1.375rem", "$extensions": { "design.massive.px": 22, "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 2.2 } } },
    "4xl": { "$type": "dimension", "$value": "1.625rem", "$extensions": { "design.massive.px": 26, "design.massive.derivedFrom": { "base": "{radius.base}", "multiplier": 2.6 } } }
  },

  "shadow": {
    "$description": "Tailwind v4의 기하는 그대로 두고 알파만 우리 사다리로 덮는다. 라이트/다크 한 벌 — Figma에서 shadow는 Effect Style이라 모드 전환이 안 된다. 다크 elevation은 border가 표현한다",
    "xs": { "$type": "shadow", "$value": [
      { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#000000", "alpha": 0.05 }
    ] },
    "sm": { "$type": "shadow", "$value": [
      { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#000000", "alpha": 0.08 },
      { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px", "color": "#000000", "alpha": 0.08 }
    ] },
    "md": { "$type": "shadow", "$value": [
      { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "#000000", "alpha": 0.10 },
      { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px", "color": "#000000", "alpha": 0.10 }
    ] },
    "lg": { "$type": "shadow", "$value": [
      { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "#000000", "alpha": 0.12 },
      { "offsetX": "0px", "offsetY": "4px",  "blur": "6px",  "spread": "-4px", "color": "#000000", "alpha": 0.12 }
    ] },
    "xl": { "$type": "shadow", "$value": [
      { "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px", "color": "#000000", "alpha": 0.16 },
      { "offsetX": "0px", "offsetY": "8px",  "blur": "10px", "spread": "-6px", "color": "#000000", "alpha": 0.16 }
    ] }
  },

  "borderWidth": {
    "$description": "Tailwind v4에서 border-width는 @theme 네임스페이스가 아니다(border-2는 정적 유틸). CSS 출력 없이 DTCG·Figma에만 산다",
    "1": { "$type": "dimension", "$value": "1px", "$extensions": { "design.massive.px": 1, "design.massive.noCss": true } },
    "2": { "$type": "dimension", "$value": "2px", "$extensions": { "design.massive.px": 2, "design.massive.noCss": true } }
  },

  "duration": {
    "$description": "CSS는 --default-transition-duration 하나만 쓰고(150ms), 세 값은 DTCG·Figma에 산다 — v4의 duration 유틸리티는 동적이다",
    "fast": { "$type": "duration", "$value": "150ms", "$extensions": { "design.massive.noCss": true } },
    "base": { "$type": "duration", "$value": "200ms", "$extensions": { "design.massive.noCss": true } },
    "slow": { "$type": "duration", "$value": "300ms", "$extensions": { "design.massive.noCss": true } }
  },

  "easing": {
    "$description": "둘 다 Tailwind 기본 --ease-out/--ease-in-out과 정확히 동일 — override 0개. 우리가 하는 일은 이 둘만 승인한다는 문서화뿐",
    "out":    { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  },

  "state": {
    "$description": "상태 색 토큰은 0개다. 컴포넌트가 color.state.layer를 이 불투명도로 color-mix 한다",
    "hover":    { "opacity": { "$type": "number", "$value": 0.08, "$extensions": { "design.massive.noCss": true } } },
    "pressed":  { "opacity": { "$type": "number", "$value": 0.12, "$extensions": { "design.massive.noCss": true } } },
    "disabled": { "opacity": { "$type": "number", "$value": 0.5,  "$extensions": { "design.massive.noCss": true } } }
  }
}
