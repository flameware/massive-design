{
  "name": "@flameware/tokens",
  "version": "0.5.0",
  "type": "module",
  "description": "massive-design 토큰 — OKLCH 램프에서 생성한 CSS 한 장과 semantic 토큰 타입",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flameware/massive-design.git",
    "directory": "packages/tokens"
  },
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./ramp": {
      "types": "./dist/ramp.d.ts",
      "default": "./dist/ramp.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "tokens:ramp": "node scripts/ramp.mjs",
    "tokens:build": "node scripts/build.mjs",
    "tokens:lint": "node scripts/lint.mjs",
    "tokens:contrast": "node scripts/contrast.mjs",
    "tokens:verify": "node scripts/verify.mjs",
    "check": "node scripts/lint.mjs && node scripts/contrast.mjs && node scripts/verify.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "apca-w3": "^0.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
