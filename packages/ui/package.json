{
  "name": "@massive/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "manifest": "bun scripts/manifest.mjs",
    "manifest:verify": "bun scripts/manifest-verify.mjs",
    "check": "node scripts/check.mjs && tsc --noEmit && bun scripts/manifest-verify.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@massive/tokens": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
