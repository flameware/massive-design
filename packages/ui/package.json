{
  "name": "@flameware/ui",
  "version": "0.2.0",
  "type": "module",
  "description": "massive-design 컴포넌트 — Base UI 위의 2세대 @flameware/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flameware/massive-design.git",
    "directory": "packages/ui"
  },
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "default": "./dist/dialog/index.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog/index.d.ts",
      "default": "./dist/alert-dialog/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "default": "./dist/drawer/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "default": "./dist/icon/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "default": "./dist/field/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./textarea": {
      "types": "./dist/textarea/index.d.ts",
      "default": "./dist/textarea/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "default": "./dist/card/index.js"
    },
    "./alert": {
      "types": "./dist/alert/index.d.ts",
      "default": "./dist/alert/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "default": "./dist/menu/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar/index.d.ts",
      "default": "./dist/avatar/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "default": "./dist/separator/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "default": "./dist/tooltip/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "default": "./dist/table/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "check": "node scripts/check.mjs && bun run build && tsc --noEmit",
    "test": "bun run build && node --test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@flameware/tokens": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
